generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  // Auth.js writes these four through `@auth/prisma-adapter`. `email` stays
  // non-null (the rest of the app assumes an address) — safe because Google
  // always returns a verified email, unlike providers that let users hide one.
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // Nullable: an OAuth-only user never has a password, and `createUser` does
  // not supply one. Credentials sign-in (Auth Phase 2) fills it for the users
  // that register with an email and password.
  passwordHash String?

  // One live token per user, so a re-send overwrites the previous link rather
  // than leaving both working. Both are nulled the moment the link is consumed.
  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiary       Apiary?
  subscription Subscription?
  usagePeriods UsagePeriod[]
  aiReports    AiReport[]
  accounts     Account[]
  sessions     Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  tier                 PlanTier  @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  status               String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PlanTier {
  FREE
  PREMIUM
}

model UsagePeriod {
  id                 String   @id @default(cuid())
  userId             String
  periodStart        DateTime
  pdfGenerationsUsed Int      @default(0)
  aiReportsUsed      Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
}

model Apiary {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hives     Hive[]
  aiReports AiReport[]
}

model Hive {
  id        String   @id @default(cuid())
  apiaryId  String
  label     String
  hiveType  HiveType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currentInspectionId String?     @unique
  currentInspection   Inspection? @relation("CurrentState", fields: [currentInspectionId], references: [id], onDelete: SetNull)

  apiary      Apiary       @relation(fields: [apiaryId], references: [id], onDelete: Cascade)
  inspections Inspection[] @relation("HiveInspections")

  @@index([apiaryId])
}

enum HiveType {
  WIELKOPOLSKI
  DADANT
  LANGSTROTH
  WARRE
  LAYENS
  OTHER
}

model Inspection {
  id          String   @id @default(cuid())
  hiveId      String
  userId      String
  inspectedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  queen   Json
  colony  Json
  comb    Json
  brood   Json
  health  Json
  actions Json
  notes   String @default("")

  combSchemaVersion Int               @default(2)
  honeyKg           Float?
  honeySufficiency  HoneySufficiency?
  combCondition     CombCondition?

  hive           Hive               @relation("HiveInspections", fields: [hiveId], references: [id], onDelete: Cascade)
  pdfJobs        PdfGenerationJob[]
  currentForHive Hive?              @relation("CurrentState")

  @@index([hiveId, inspectedAt])
  @@index([userId])
}

enum HoneySufficiency {
  SUFFICIENT
  MODERATE
  LOW
  NONE
}

enum CombCondition {
  GOOD
  OLD
  NEEDS_REPLACEMENT
}

model PdfGenerationJob {
  id           String       @id @default(cuid())
  inspectionId String
  status       PdfJobStatus @default(PENDING)
  requestedAt  DateTime     @default(now())
  completedAt  DateTime?
  fileUrl      String?
  errorMessage String?
  attempts     Int          @default(0)

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId, status])
}

enum PdfJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model AiReport {
  id        String   @id @default(cuid())
  apiaryId  String
  userId    String
  createdAt DateTime @default(now())
  content   String
  model     String

  apiary Apiary @relation(fields: [apiaryId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apiaryId, createdAt])
  @@index([userId])
}
