# Copy this file to .env.local for local development.
# For deployments, set the same variable in your Vercel project settings.

# URL of the PDF generation microservice (proxied via app/api/generate-pdf/route.ts).
PDF_SERVICE_URL=https://pdf-service-efq0.onrender.com/generate-pdf

# ── Database (Neon PostgreSQL + Prisma) ──────────────────────────────────────
# Prisma 7 does not load .env itself; prisma.config.ts loads this file's local
# counterpart (.env.local) explicitly, so the CLI and Next.js read the same vars.
#
# Use the *pooled* Neon endpoint here (host contains "-pooler"). That is what the
# app queries through at runtime — Neon's pooler is what keeps serverless
# functions from exhausting Postgres connections.
#
# Branch split: local development points at the Neon **development** branch.
# The **production** branch URL belongs only in the Vercel project's env vars,
# never in a local file.
#
# Use `sslmode=verify-full`, not `sslmode=require`. node-postgres currently
# treats `require` as an alias for `verify-full`, but pg v9 / pg-connection-string
# v3 will switch it to libpq semantics, which skip certificate verification —
# silently weakening the connection on a routine dependency bump. Spelling out
# `verify-full` pins the strong behavior. Neon's certificates chain to a public
# CA, so Node's built-in trust store validates them with no extra config.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# The direct (non-pooled) Neon endpoint — same host without "-pooler".
# `prisma migrate` takes Postgres advisory locks, which don't survive PgBouncer's
# transaction pooling; prisma.config.ts uses this for migrations when set and
# falls back to DATABASE_URL when it isn't.
#
# Optional locally, where migrations are run by hand and a hang is visible.
# **Set it in Vercel**: `vercel-build` runs `prisma migrate deploy` on every
# deploy, so a lock that doesn't survive the pooler is no longer a hang someone
# watches and retries — it is a failed deploy.
# DIRECT_DATABASE_URL=

# Context7 MCP server key. Not referenced in .mcp.json: @upstash/context7-mcp reads
# CONTEXT7_API_KEY straight from the environment, so the server inherits it and the
# key never appears in committed config. It must be a real environment variable,
# not just written here:
#   PowerShell:  setx CONTEXT7_API_KEY "ctx7sk-..."   (then restart the terminal)
#   bash/zsh:    export CONTEXT7_API_KEY="ctx7sk-..." in ~/.bashrc or ~/.zshrc
CONTEXT7_API_KEY=

# Auth.js (NextAuth v5). Signs and encrypts the session JWT, so changing it
# invalidates every live session. Generate with:
#   openssl rand -base64 32
# NOT `npx auth secret` — the `auth` npm package is Better Auth's CLI, a
# different library. Use a DIFFERENT value in production than locally.
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application). Auth.js infers these from the
# AUTH_<PROVIDER>_ID / _SECRET convention, so the provider takes no arguments.
# Authorized redirect URI for local dev:
#   http://localhost:3000/api/auth/callback/google
# Production needs its own URI on the same client, or a separate client.
# While the OAuth consent screen is in "Testing" status, only accounts listed
# as test users can sign in.
# This file is committed — put the real values in .env.local, never here.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Master switch for the whole email-verification requirement, read in exactly one
# place: isEmailVerificationEnabled() in app/lib/email/config.ts.
#
# OFF (unset, or anything other than true/1/yes/on) — registration creates an
# account that is already marked verified, sends no email, and goes straight to
# the sign-in page. RESEND_API_KEY is then not needed at all.
# ON — registration mails a link and /dashboard stays closed until it is clicked.
#
# It defaults to OFF because onboarding@resend.dev is Resend's shared sandbox
# sender and only delivers to the account that owns the API key: until a domain
# is verified at resend.com/domains, an enabled default strands every
# registration but one. The trade-off is that forgetting this variable in a
# deployment ships verification disabled rather than failing loudly.
#
# Switching it ON later is safe — accounts created while it was off carry an
# emailVerified timestamp written at registration, so none of them are locked
# out and no backfill is needed.
EMAIL_VERIFICATION_ENABLED=

# Resend. Sends the registration verification email. Server-only — never
# NEXT_PUBLIC_. Get a key at resend.com → API Keys.
# The from address is onboarding@resend.dev, Resend's shared sandbox sender: it
# only delivers to the address that owns the API key. Verify a domain before
# real users register, or every verification mail after the first is dropped.
# Only read when EMAIL_VERIFICATION_ENABLED is on; leave it blank otherwise.
RESEND_API_KEY=

# Absolute origin used to build the verification link in that email. No
# NEXT_PUBLIC_ prefix: the link is assembled inside the send helper and never
# reaches the browser. Falls back to AUTH_URL, then http://localhost:3000.
# On Vercel set this to the deployment's public URL.
APP_URL=http://localhost:3000

# Redis rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=